source/**/dist/
source/**/dist-standalone/
source/**/dist-pages/
tests/.build/

# 本地归档（体积大，且是历史快照）
_backup/

# 安装包：二进制、由安卓工程构建。默认不入库（历史会永久膨胀），
# 但仓库根那份是给同学直接下载的正式发布包，用否定规则单独放行。
*.apk
!线性代数计算器-v*.apk

# 本地产物快照（单文件版与离线站由 npm run build 生成）
source/linear-algebra-calculator/web-source/dist-standalone/
source/linear-algebra-calculator/web-source/dist-pages/
# 单文件的构建副本：根目录那份保留给人下载，源码目录里的不入库
source/**/线性代数计算器.html

